<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.contributor.view.ProcessingFileController">
    <children>
        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="200.0" spacing="10.0"
            VBox.vgrow="NEVER">
            <children>
                <ComboBox fx:id="cbxLang" prefWidth="150.0" promptText="Lang" />
                <Button mnemonicParsing="false" text="Processing"
                    onAction="#handlerOnProcessingButton" />

            </children>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
        <TableView fx:id="tblFile" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcCheck" prefWidth="75.0" />
                <TableColumn fx:id="tbcVideoFile" prefWidth="75.0" text="Video File" />
                <TableColumn fx:id="tbcSubFile" prefWidth="75.0" text="Subtitle File" />
                <TableColumn fx:id="tbcLang" prefWidth="75.0" text="Lang" />
                <TableColumn fx:id="tbcProcessing" prefWidth="75.0" text="Processing Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
