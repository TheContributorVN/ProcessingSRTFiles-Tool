<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.contributor.view.WelcomeController">
    <HBox alignment="BOTTOM_RIGHT" prefHeight="50.0" prefWidth="500.0" VBox.vgrow="ALWAYS">
        <Button fx:id="btnOpenDir" onAction="#handleOnOpenDir" text="Open Folder" />
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </VBox.margin>
    </HBox>

    <ListView fx:id="lView" prefHeight="500.0" prefWidth="600.0">

    </ListView>
</VBox>
