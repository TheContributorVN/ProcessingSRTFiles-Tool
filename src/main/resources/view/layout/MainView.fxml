<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
    minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1100.0" spacing="20.0"
    xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.contributor.view.MainController">
    <children>
        <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="400.0"
            prefWidth="400.0" HBox.hgrow="ALWAYS">
            <TreeView fx:id="tviewPath" VBox.vgrow="ALWAYS">
            </TreeView>
        </VBox>
        <VBox alignment="CENTER" maxHeight="1.7976931348623157E308"
            maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0"
                    VBox.vgrow="NEVER">
                    <children>
                        <TextField fx:id="tfPath" prefWidth="200.0" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </TextField>
                        <Button mnemonicParsing="false" onAction="#handlerOnBrowserButton"
                            text="Browser" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handlerOnRefreshButton"
                            text="Refresh" />
                        <Button fx:id="btnProcessing" mnemonicParsing="false" text="Processing"
                            onAction="#handlerOnProcessingButton" />

                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="5.0" right="5.0" top="5.0" />
                    </padding>
                </HBox>
                <TableView fx:id="tFile" prefHeight="200.0" prefWidth="700.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="iconCol" prefWidth="75.0" />
                        <TableColumn fx:id="fileNameCol" prefWidth="75.0" text="Tên File" />
                        <TableColumn fx:id="typeCol" prefWidth="75.0" text="Loại" />
                        <TableColumn fx:id="sizeCol" prefWidth="75.0" text="Kích thước" />
                        <TableColumn fx:id="langCol" prefWidth="75.0" text="Ngôn ngữ" />
                        <TableColumn fx:id="statusCol" prefWidth="75.0" text="Trạng thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>
